# ======================================================================
# PETORA configuration. Copy to .env and fill in. NEVER commit .env.
# Generate secrets with:  openssl rand -base64 48   (JWT)  /  openssl rand -base64 32 (encryption key)
# ======================================================================

# --- Application ---
APP_ENV=production                 # development | staging | production
APP_BASE_URL=https://petora.in     # public origin (cookies are Secure when https)
DOMAIN=petora.in                   # Caddy site address (TLS certificates are issued automatically)
ACME_EMAIL=ops@petora.in
ALLOWED_ORIGINS=https://petora.in
LOG_LEVEL=info
VERSION=1.0.0

# --- Secrets (REQUIRED) ---
JWT_SECRET=
DATA_ENCRYPTION_KEY=               # base64 of exactly 32 random bytes (encrypts staff MFA secrets)

# --- Database (docker-compose builds DATABASE_URL from these) ---
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_OWNER_PASSWORD=           # used only by the migrate job
POSTGRES_APP_PASSWORD=             # runtime role with DML-only privileges
# DATABASE_URL=postgres://petora_app:...@postgres:5432/petora?sslmode=disable   (set automatically in compose)

# --- Redis ---
REDIS_PASSWORD=

# --- Payments ---
# testmode is REFUSED when APP_ENV=production. Use Razorpay test keys (rzp_test_...) on staging.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=           # configure webhook URL https://<domain>/api/v1/webhooks/razorpay

# --- Storage ---
STORAGE_DRIVER=local               # local (Docker volume) | s3 (S3, R2, MinIO, Spaces)
# PUBLIC_MEDIA_URL=https://cdn.petora.in   # optional CDN in front of public media
# S3_ENDPOINT=s3.ap-south-1.amazonaws.com
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BUCKET=petora-public    # public-read (pet photos)
# S3_PRIVATE_BUCKET=petora-private  # NO public access (verification documents)
# S3_USE_SSL=true

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PETORA <no-reply@petora.in>

# --- Backups ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR_UTC=21                 # 02:30 IST
BACKUP_AGE_RECIPIENT=              # age public key (age1...). Keep the private key OFF the server.

# --- Single-container mode (optional): run the worker inside the API process ---
# WORKER_INLINE=false
# AUTO_MIGRATE=false
